# Copy to .env.local (gitignored) and fill in from your Supabase project's
# Project Settings → API page. Required for /codex/register and the /codex
# table's live data — see supabase/migrations/0001_init.sql for the schema
# these must point at.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
